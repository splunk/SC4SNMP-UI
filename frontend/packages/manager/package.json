{
  "name": "@splunk/manager",
  "version": "1.3.0",
  "license": "UNLICENSED",
  "scripts": {
    "build": "NODE_ENV=production webpack --bail --config demo/webpack.standalone.config.js",
    "eslint": "eslint src --ext \".js,.jsx\"",
    "eslint:ci": "yarn run eslint -f junit -o test-reports/lint-results.xml",
    "eslint:fix": "eslint src --ext \".js, .jsx\" --fix",
    "link:app": "ln -s $PWD/demo/splunk-app $SPLUNK_HOME/etc/apps/manager-demo-app",
    "lint": "yarn run eslint && yarn run stylelint",
    "lint:ci": "yarn run eslint:ci && yarn run stylelint",
    "start": "webpack --watch",
    "start:app": "webpack --watch --config demo/webpack.splunkapp.config.js",
    "start:demo": "webpack-dev-server --config demo/webpack.standalone.config.js --port ${DEMO_PORT-8080} --host 0.0.0.0",
    "stylelint": "stylelint \"src/**/*.{js,jsx}\" --config stylelint.config.js",
    "test": "DEBUG_PRINT_LIMIT=1000000 jest",
    "test:ci": "JEST_JUNIT_OUTPUT_DIR=./test-reports JEST_JUNIT_OUTPUT_NAME=unit-results.xml JEST_JUNIT_CLASSNAME=unit yarn run test --ci --reporters=default jest-junit --coverage --coverageDirectory=coverage_report/coverage_maps_unit --coverageReporters=cobertura",
    "test:watch": "jest --watch"
  },
  "main": "Manager.js",
  "dependencies": {
    "@splunk/react-icons": "^5.15.0",
    "@splunk/react-ui": "^5.16.0",
    "@splunk/themes": "^1.12.0",
    "@splunk/ui-utils": "^1.14.1",
    "axios": "^1.16.0",
    "css-loader": "^7.1.4",
    "history": "5.3.0",
    "prop-types": "^15.8.0",
    "qs": "6.15.3",
    "style-loader": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@eslint/js": "^9.39.4",
    "@jest/globals": "^30.4.1",
    "@splunk/babel-preset": "^4.0.0",
    "@splunk/eslint-config": "^6.0.0",
    "@splunk/splunk-utils": "^4.0.1",
    "@splunk/stylelint-config": "^5.1.0",
    "@splunk/webpack-configs": "^5.0.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "16.3.3",
    "@webpack-cli/serve": "^3.0.1",
    "babel-loader": "^10.1.1",
    "eslint": "^9.39.4",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "querystring-es3": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "5.3.11",
    "stylelint": "^17.14.1",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "peerDependencies": {
    "react": "^16.8 || ^17.0.0 || ^18.0.0",
    "styled-components": "5.3.11"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
